MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 446591784}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a99104bf242e7e84183256d5aa7cd3ee, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  panelDialog: {fileID: 647734579}
  komponenTeksDialog: {fileID: 2091056828}
  komponenTeksNama: {fileID: 1591040976}
  daftarDialogEnding:
  - namaKarakter: 
    kalimatDialog: '*Riyu,Gita dan Dina sedang berada di ruang dosen*'
  - namaKarakter: Dosen
    kalimatDialog: Kenapa riyu kamu mencari saya?
  - namaKarakter: Dina
    kalimatDialog: 'Tau tuh pak bawa bawa saya juga '
  - namaKarakter: Riyu
    kalimatDialog: Jadi gini pak...
  - namaKarakter: Riyu
    kalimatDialog: Bapak tau kan postingan tentang gita yang ada di Chamber itu?
  - namaKarakter: Dosen
    kalimatDialog: Ada apa emangnya?
  - namaKarakter: Riyu
    kalimatDialog: Itu adalah berita hoax pak
  - namaKarakter: Riyu
    kalimatDialog: Gita itu mahasiswa paling pintar masa iya dia menyontek
  - namaKarakter: Riyu
    kalimatDialog: Dan saya tau siapa dalang dibaling postingan tersebut
  - namaKarakter: Dosen
    kalimatDialog: Siapa Emangnya?
  - namaKarakter: Riyu
    kalimatDialog: Yang membuat postingan tersebut adalah...
  - namaKarakter: Riyu
    kalimatDialog: Dina!!
  - namaKarakter: Dina
    kalimatDialog: Hah...? yang benar aja kamu fitnah fitnah orang
  - namaKarakter: Gita
    kalimatDialog: Emang kamu tau dari mana kalau postingan itu Dina yang buat?
  - namaKarakter: Riyu
    kalimatDialog: Jadi kemaren aku mencoba untuk masuk ke database dari aplikasi
      tersebut
  - namaKarakter: Riyu
    kalimatDialog: dan aku berhasil masuk,lalu aku mencoba mencari username tersebut
  - namaKarakter: Riyu
    kalimatDialog: setelah menemukan username tersebut,aku melihat nama mu yang terdaftar
      sebagai emailnya!!!
  - namaKarakter: Dosen
    kalimatDialog: APAKAH ITU BENAR DINA?!!
  - namaKarakter: Dina
    kalimatDialog: GAK PAK ITU BOHONGAN
  - namaKarakter: Riyu
    kalimatDialog: Bohong apanya?,aku punya bukti loh
  - namaKarakter: 
    kalimatDialog: '*Riyu memperlihatkan bukti tersebut*'
  - namaKarakter: Dosen
    kalimatDialog: Dina,Kau tau kan peraturan kampus ini jika menyebarkan hoax?
  - namaKarakter: Dina
    kalimatDialog: Please pak Jangan keluarkan saya!
  - namaKarakter: Dina
    kalimatDialog: Saya hanya iri karna dia lebih baik dari saya!
  - namaKarakter: Dosen
    kalimatDialog: Peraturan adalah peraturan dina
  - namaKarakter: Dosen
    kalimatDialog: Sekarang kamu saya DO!
  - namaKarakter: Gita
    kalimatDialog: Terimakasih Riyu Kau telah menyelamatkan ku dari hoax ini <3
  timelineDirector: {fileID: 446591785}
